{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oseupsico",
  "main": "_worker.js",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/psicologos/perfil.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oseupsico-psicologos-db",
      "database_id": "a598c4c9-7ab6-4759-aecb-260d9b30ffda"
    },
    {
      "binding": "TESTES_DB",
      "database_name": "oseupsico-testes-db",
      "database_id": "13e0e96c-87b0-4af8-8bbd-e79e98f589d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS_BUCKET",
      "bucket_name": "oseupsico-psicologos-fotos"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "dev": {
    "port": 8787
  }
}
